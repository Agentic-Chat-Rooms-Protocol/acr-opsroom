{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@acr-js/opsroom-core": ["../core/dist/src/index.d.ts"]
    },
    "outDir": "./dist",
    "rootDir": "./"
  },
  "references": [
    { "path": "../core" }
  ],
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
